# ═══════════════════════════════════════════════════════════
# CRM Digiran — نمونه فایل محیطی
# این فایل رو کپی کن به .env و مقادیر رو تنظیم کن
# ═══════════════════════════════════════════════════════════

# ─── امنیت (اجباری در production) ───
# برای تولید، یه کلید ۵۰+ کاراکتری تصادفی بساز:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# ─── حالت اجرا ───
# توی توسعه: True / توی production: False
DEBUG=True

# ─── دامنه‌ها ───
# در production: دامنه‌ی واقعی مثل example.com,www.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# برای production اجباری (اگه از HTTPS استفاده می‌کنی)
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ─── دیتابیس ───
# اگه خالی باشه، SQLite استفاده می‌شه (فقط برای توسعه)
# برای production از PostgreSQL استفاده کن:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ─── HTTPS (فقط production) ───
# SECURE_SSL_REDIRECT=True
